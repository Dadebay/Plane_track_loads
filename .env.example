# Database
DATABASE_URL="postgresql://tua:tua_dev_password@localhost:5432/tua_load_control?schema=public"

# Auth.js
AUTH_SECRET="change-me-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Official airline logo embedded in generated documents (PNG or JPG).
# Unset: documents print a plain green disc and wordmark instead.
DOCUMENTS_LOGO_PATH=""

# Documents — keep true until validation dossier (Faz 14) and authority
# acceptance are complete. See docs/IMPLEMENTATION_PLAN.md Bölüm D.
# Operatör kararı (2026-09-11): belgeler filigransız üretiliyor.
# "true" yaparsanız her PDF'e NOT FOR OPERATIONAL USE filigranı döner.
DOCUMENTS_WATERMARK="false"

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE="en"
